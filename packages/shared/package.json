{
  "name": "@rideujap/shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "type-check": "tsc --noEmit",
    "build": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\""
  },
  "prettier": "@rideujap/prettier-config",
  "devDependencies": {
    "@rideujap/eslint-config": "workspace:*",
    "@rideujap/prettier-config": "workspace:*",
    "@rideujap/tsconfig": "workspace:*",
    "eslint": "^9.18.0",
    "prettier": "^3.9.5",
    "typescript": "^6.0.3"
  }
}
