# Conexión a PostgreSQL (coincide con los defaults de docker-compose.yaml en la raíz)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/rideujap

# Better Auth
# Secreto para firmar tokens/cookies de sesión. Generar con: openssl rand -base64 32
BETTER_AUTH_SECRET=cambia-esto-por-un-secreto-de-32-bytes
# URL base pública del API (donde vive el handler /api/auth/*)
BETTER_AUTH_URL=http://localhost:3000

# Mapbox — token de acceso para el autocomplete de ubicaciones (/places/*).
# Crear uno gratis en https://account.mapbox.com/access-tokens/
MAPBOX_ACCESS_TOKEN=
