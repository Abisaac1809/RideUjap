    "@rideujap/tsconfig": "workspace:*",
    "@types/react": "~19.2.18",
    "eslint": "^9.18.0",
    "prettier": "^3.9.5",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "expo": "^57.0.13",
    "expo-status-bar": "^57.0.1",
    "nativewind": "^4.2.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-css-interop": "0.2.6",
    "react-native-web": "~0.21.0",
    "tailwindcss": "^3.4.19"
